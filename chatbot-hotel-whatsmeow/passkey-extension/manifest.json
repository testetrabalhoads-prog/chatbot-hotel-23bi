{
  "manifest_version": 3,
  "name": "WA Passkey Connector - Northflank",
  "version": "1.0.0",
  "description": "Executa a assertion WebAuthn do WhatsApp no navegador do dono da conta.",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.code.run/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.code.run/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}